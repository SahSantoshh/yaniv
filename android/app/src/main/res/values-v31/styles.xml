<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ shows this system splash before launch_background. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bottom</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_bottom</item>
    </style>
</resources>
